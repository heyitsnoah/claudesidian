{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .scripts/session-start.js"
          },
          {
            "type": "command",
            "command": "npm run check-updates --silent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/skill-discovery.sh",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ]
  }
}
